# Copy to .env and fill in. Never commit .env. Every value an administrator can
# change at runtime (SMTP, SSO, LDAP, security policy, branding...) lives in
# System Settings, not here; this file holds infrastructure wiring only.

APP_NAME="Low-Code Framework"
APP_ENV=production
# Required. Generate with:
#   docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_VERSION=0.1.0
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Reverse proxies allowed to set X-Forwarded-* (comma separated IPs/CIDRs).
TRUSTED_PROXIES=127.0.0.1,::1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
# Error monitoring secondary sink (JSON lines), survives database outages.
ERROR_SINK_PATH=/var/www/backend/storage/logs/errors/errors.log
ERROR_SINK_DAYS=90

# Database: mysql (MySQL 8) or sqlsrv (SQL Server 2019+). The values below match
# the MySQL container; DB_PASSWORD must equal DB_PASSWORD in the root .env.
# For the SQL Server container use DB_CONNECTION=sqlsrv, DB_HOST=sqlserver,
# DB_PORT=1433, DB_USERNAME=sa, DB_PASSWORD=<MSSQL_SA_PASSWORD from the root .env>.
# The database is created with the prescribed collation on first start.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lcf
DB_USERNAME=lcf
DB_PASSWORD=
# SQL Server only: TLS to the database (keep "yes"; trust a self-signed
# certificate only in development).
DB_ENCRYPT=yes
# The SQL Server container uses a self-signed certificate: set true for it.
DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=lcf-database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
# Defaults to true when APP_URL starts with https:// (always use HTTPS in production).
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:8080

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing mail uses the SMTP settings from System Settings (mailer "lcf").
MAIL_MAILER=lcf

# Uploaded files: outside the public root.
FILES_ROOT=/var/www/backend/storage/app/files
FILESYSTEM_DISK=private

HASH_DRIVER=argon2id
BROADCAST_CONNECTION=log
