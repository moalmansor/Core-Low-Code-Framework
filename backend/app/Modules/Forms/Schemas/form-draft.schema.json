          ],
          "pattern": "^[a-z -]{0,64}$"
        },
        "spellcheck": {
          "type": "boolean"
        },
        "cssClass": {
          "$ref": "#/$defs/cssClass"
        },
        "props": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/scalar"
              },
              {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "$ref": "#/$defs/scalar"
                }
              },
              {
                "$ref": "#/$defs/i18nLong"
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "tableSettings": {
      "type": "object",
