              "minimum": 0
            },
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "number": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?[0-9]{1,30}(\\.[0-9]{1,18})?$"
            },
            "max": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?[0-9]{1,30}(\\.[0-9]{1,18})?$"
            },
            "step": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{1,30}(\\.[0-9]{1,18})?$"
            }
          },
          "additionalProperties": false
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "format": {
          "enum": [
            null,
            "email",
            "url",
            "phone",
            "national_id",
            "iban",
            "numeric",
            "arabic",
            "english",
            "alphanumeric"
          ]
        },
        "date": {
          "type": "object",
          "properties": {
            "min": {
              "$ref": "#/$defs/astOrNull"
            },
            "max": {
              "$ref": "#/$defs/astOrNull"
            },
            "disabledWeekdays": {
              "type": "array",
              "maxItems": 7,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "disabledDates": {
              "type": "array",
              "maxItems": 500,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            },
            "noPast": {
              "type": "boolean"
            },
            "noFuture": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "file": {
          "type": "object",
          "properties": {
            "types": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]{1,10}$"
              }
            },
            "mimes": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9.+-]+/[a-z0-9.+*-]+$"
              }
            },
            "maxSizeKb": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 1048576
            },
            "maxCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 100
            },
            "image": {
              "type": "object",
              "properties": {
                "minWidth": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "maxWidth": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "minHeight": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "maxHeight": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "unique": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "$ref": "#/$defs/uuid"
                  }
                },
                "includeDeleted": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "compare": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "op",
              "field"
            ],
            "properties": {
              "op": {
                "enum": [
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "eq",
                  "neq",
                  "before",
                  "after"
                ]
              },
              "field": {
                "$ref": "#/$defs/uuid"
              }
            },
            "additionalProperties": false
          }
        },
        "async": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "type",
                "collection",
                "path"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "exists_in",
                    "not_exists_in"
                  ]
                },
                "collection": {
                  "$ref": "#/$defs/uuid"
                },
                "path": {
                  "$ref": "#/$defs/path"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "custom": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "when",
              "messageKey"
            ],
            "properties": {
              "when": {
                "$ref": "#/$defs/ast"
              },
              "messageKey": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "properties": {
        "default": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "static",
                    "current_user",
                    "current_department",
                    "now",
                    "today",
                    "url_param",
                    "field",
                    "formula",
                    "reference"
                  ]
                },
                "value": {},
                "param": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                },
                "field": {
                  "$ref": "#/$defs/uuidOrNull"
                },
                "expr": {
                  "$ref": "#/$defs/astOrNull"
                },
                "reference": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "path": {
                          "$ref": "#/$defs/path"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "formula": {
          "$ref": "#/$defs/astOrNull"
        },
        "transforms": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "trim",
              "uppercase",
              "lowercase",
              "collapse_spaces"
            ]
          }
        },
        "mask": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "pattern": "^[9aA*#()\\-+ ./:]*$"
        },
        "number": {
          "type": "object",
          "properties": {
            "thousandSeparator": {
              "type": "boolean"
            },
            "decimals": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 18
            },
            "currency": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{3}$"
            },
            "symbolPosition": {
              "enum": [
                "before",
                "after"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9_]{1,16}$"
            }
          },
          "additionalProperties": false
        },
        "date": {
          "type": "object",
          "properties": {
            "displayFormat": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[dMyHhmsa /.:,-]{0,32}$"
            },
            "calendar": {
              "enum": [
                "gregorian",
                "hijri",
                "dual"
              ]
            },
            "firstDayOfWeek": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "timeStep": {
              "type": "integer",
              "minimum": 1,
              "maximum": 720
            },
            "hourCycle": {
              "enum": [
                "12h",
                "24h"
              ]
            },
            "timezone": {
              "type": "string",
              "pattern": "^(user|utc|fixed:[A-Za-z_]+(/[A-Za-z_+-]+){0,2})$"
            }
          },
          "additionalProperties": false
        },
        "digits": {
          "enum": [
            "western",
            "arabic_indic",
            "locale"
          ]
        },
        "file": {
          "type": "object",
          "properties": {
            "disk": {
              "enum": [
                "private",
                "public"
              ]
            },
            "folder": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_{}/-]{0,128}$"
            },
            "naming": {
              "enum": [
                "uuid",
                "original_sanitized"
              ]
            }
          },
          "additionalProperties": false
        },
        "autofill": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/path"
              },
              "to": {
                "$ref": "#/$defs/uuid"
              },
              "overwrite": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "autoNumber": {
          "$ref": "#/$defs/uuidOrNull"
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "size": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "width": {
          "$ref": "#/$defs/breakpoints"
        },
        "labelPosition": {
          "enum": [
            "top",
            "side",
            "hidden"
          ]
        },
        "autofocus": {
          "type": "boolean"
        },
        "tabIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -1,
          "maximum": 32767
        },
        "autocomplete": {
          "type": [
            "string",
