          ],
          "maxLength": 128
        },
        "print": {
          "type": "boolean"
        },
        "pdf": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "on",
        "do"
      ],
      "properties": {
        "on": {
          "enum": [
            "change",
            "focus",
            "blur"
          ]
        },
        "when": {
          "$ref": "#/$defs/astOrNull"
        },
        "do": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "set_field",
                  "reload_options",
                  "run_action",
                  "call_webhook",
                  "notify"
                ]
              },
              "target": {
                "$ref": "#/$defs/uuidOrNull"
              },
              "value": {
                "$ref": "#/$defs/astOrNull"
              },
              "action": {
                "$ref": "#/$defs/uuidOrNull"
              },
              "webhook": {
                "$ref": "#/$defs/uuidOrNull"
              },
              "severity": {
                "enum": [
                  "info",
                  "success",
                  "warning",
                  "error"
                ]
              },
              "message": {
                "$ref": "#/$defs/i18nText"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "uuid",
        "key",
        "type",
        "target",
        "kind",
        "onDelete"
      ],
      "properties": {
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "enum": [
            "one_to_one",
            "one_to_many",
            "many_to_one",
            "many_to_many"
          ]
        },
        "target": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "reference",
            "child_table",
            "subform"
          ]
        },
        "onDelete": {
          "enum": [
            "restrict",
            "cascade",
            "set_null"
          ]
        },
        "display": {
          "$ref": "#/$defs/uuidOrNull"
        },
        "value": {
          "$ref": "#/$defs/uuidOrNull"
        },
        "inverse": {
          "$ref": "#/$defs/keyOrNull"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "type",
        "uuid"
      ],
      "properties": {
        "type": {
          "enum": [
            "field",
            "group",
            "option",
            "action",
            "transition"
          ]
        },
        "uuid": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": [
        "effect"
      ],
      "properties": {
        "effect": {
          "enum": [
            "show",
            "hide",
            "enable",
            "disable",
            "read_only",
            "require",
            "set_value",
            "clear_value",
            "reload_options",
            "show_message",
            "block_submit",
            "trigger_action"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "value": {
          "$ref": "#/$defs/ast"
        },
        "severity": {
          "enum": [
            "info",
            "success",
            "warning",
            "error"
          ]
        },
        "message": {
          "$ref": "#/$defs/i18nText"
        },
        "action": {
          "$ref": "#/$defs/uuid"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "enum": [
                  "show",
                  "hide",
                  "enable",
                  "disable",
                  "read_only",
                  "require",
                  "clear_value",
                  "reload_options"
                ]
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "set_value"
              }
            }
          },
          "then": {
            "required": [
              "target",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "enum": [
                  "show_message",
                  "block_submit"
                ]
              }
            }
          },
          "then": {
            "required": [
              "message"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "trigger_action"
              }
            }
          },
          "then": {
            "required": [
              "action"
            ]
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "required": [
        "uuid",
        "owner",
        "when",
        "effects"
      ],
      "properties": {
        "uuid": {
          "$ref": "#/$defs/uuid"
        },
        "owner": {
          "type": "object",
          "required": [
            "type",
            "uuid"
          ],
          "properties": {
            "type": {
              "enum": [
                "form",
                "field",
                "group",
                "option"
              ]
            },
            "uuid": {
              "$ref": "#/$defs/uuid"
            }
          },
          "additionalProperties": false
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "when": {
          "$ref": "#/$defs/ast"
        },
        "effects": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "else": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "evaluateOn": {
          "enum": [
            "always",
            "change"
          ]
        },
        "runtime": {
          "enum": [
            "client_and_server",
            "server_only"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "active": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
