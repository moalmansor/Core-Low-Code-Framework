          "type": "integer",
          "minimum": 5,
          "maximum": 200
        },
        "groupBy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/path"
            }
          ]
        },
        "preview": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      },
      "additionalProperties": false
    },
    "messageRef": {
      "$ref": "#/$defs/i18nText"
    },
    "validation": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "length": {
