# Passwords for the containers started by docker-compose.yml. Copy this file to
# .env (next to docker-compose.yml) and choose your own values.
#
# Use letters, digits, and - _ . ! @ % ^ * + = only. Avoid $ # " ' \ and spaces:
# Docker Compose and Laravel read some of them as variables, comments, or quotes.

DB_DATABASE=lcf
DB_USERNAME=lcf
# Required. Put the same value in backend/.env (DB_PASSWORD).
DB_PASSWORD=
# Required. The MySQL administrator password; used by nothing else.
DB_ROOT_PASSWORD=

# Only for SQL Server (docker compose --profile sqlsrv ...). SQL Server's policy:
# at least 8 characters, from at least three of: upper-case letters, lower-case
# letters, digits, symbols. SQL Server refuses to start with a weaker password.
MSSQL_SA_PASSWORD=
